# Copia a .env.local. Con mocks activos no hace falta backend.
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Destino del proxy de desarrollo hacia Spring Boot
API_PROXY_TARGET=http://localhost:8080

# Cognito/BFF: completa estos valores al crear el User Pool y el App Client.
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/login
# Genera una clave local aleatoria de al menos 32 bytes; no reutilices la clave de producción.
SESSION_ENCRYPTION_KEY=
# Clave aleatoria local para firmar la sesión demo. Solo se usa con mocks en desarrollo.
MOCK_SESSION_SECRET=
